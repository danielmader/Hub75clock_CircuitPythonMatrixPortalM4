{
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.11",
    "pythonPlatform": "Linux",
    "typeCheckingMode": "basic",
    "reportMissingModuleSource": "none",
    // "reportMissingImports": false,
    "reportGeneralTypeIssues": false,
    "extraPaths": [
        "src",
        "src/lib"
    ],
    "include": ["src"],
    "exclude": ["**/node_modules", "**/__pycache__", "**/.*", "build", "dist", "**/*.egg-info", "**/_archive_"]
}
